<Window x:Class="SKSAdminDesktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SKS Admin Desktop - Shree Krishna Signs" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E3A8A" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="40" Height="40" Fill="White" Margin="0,0,15,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" Opacity="0.3"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="SKS Admin" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="DashboardBtn" Content="Dashboard" Style="{StaticResource NavButtonStyle}" Click="DashboardBtn_Click"/>
                    <Button x:Name="ProductsBtn" Content="Products" Style="{StaticResource NavButtonStyle}" Click="ProductsBtn_Click"/>
                    <Button x:Name="OrdersBtn" Content="Orders" Style="{StaticResource NavButtonStyle}" Click="OrdersBtn_Click"/>
                    <Button x:Name="CustomersBtn" Content="Customers" Style="{StaticResource NavButtonStyle}" Click="CustomersBtn_Click"/>
                    <Button x:Name="InventoryBtn" Content="Inventory" Style="{StaticResource NavButtonStyle}" Click="InventoryBtn_Click"/>
                </StackPanel>

                <!-- User Info -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Admin User" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="Logout" Style="{StaticResource LogoutButtonStyle}" Click="LogoutBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" x:Name="MainContent">
            <!-- Dashboard View (Default) -->
            <Grid x:Name="DashboardView" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Dashboard Header -->
                <Border Grid.Row="0" Background="White" Padding="30,20" Margin="20,20,20,10">
                    <StackPanel>
                        <TextBlock Text="Dashboard Overview" FontSize="28" FontWeight="Bold" Foreground="#1E3A8A"/>
                        <TextBlock Text="Welcome to SKS Admin Dashboard" FontSize="16" Foreground="#6B7280" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Dashboard Content -->
                <Grid Grid.Row="1" Margin="20,10,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Stats Cards -->
                    <Border Grid.Column="0" Background="White" Margin="0,0,10,0" Padding="20" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="Total Products" FontSize="14" Foreground="#6B7280"/>
                            <TextBlock x:Name="TotalProductsText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#1E3A8A"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" Margin="5,0" Padding="20" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="Pending Orders" FontSize="14" Foreground="#6B7280"/>
                            <TextBlock x:Name="PendingOrdersText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#DC2626"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" Margin="5,0" Padding="20" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="Total Customers" FontSize="14" Foreground="#6B7280"/>
                            <TextBlock x:Name="TotalCustomersText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#059669"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="White" Margin="10,0,0,0" Padding="20" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="Low Stock Items" FontSize="14" Foreground="#6B7280"/>
                            <TextBlock x:Name="LowStockText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#D97706"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Other Views will be added here -->
        </Grid>
    </Grid>

    <!-- Styles -->
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
